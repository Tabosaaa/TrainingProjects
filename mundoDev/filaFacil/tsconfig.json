{
  // O Node 24 roda .ts direto (remove os tipos em tempo de execução).
  // O tsc aqui só CHECA os tipos (noEmit) — não gera JavaScript.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src"]
}
